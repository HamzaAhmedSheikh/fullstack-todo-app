# Database Configuration (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Better Auth Configuration
# BETTER_AUTH_URL points to frontend (used to construct JWKS endpoint)
# Development:
BETTER_AUTH_URL=http://localhost:3000
# Production:
# BETTER_AUTH_URL=https://task-management-system-three-ashy.vercel.app

# CORS Origins (comma-separated)
# Development: http://localhost:3000,http://localhost:5173
# Production (Hugging Face): https://task-management-system-three-ashy.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://task-management-system-three-ashy.vercel.app

# Better Auth JWT Secret (MUST match frontend)
# This is the shared secret used to sign and verify JWT tokens
BETTER_AUTH_SECRET=your-secret-key-change-in-production-min-32-chars

# Environment
ENVIRONMENT=development
